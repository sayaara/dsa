# ===================================
# AI Stock Analysis System - environment variable configuration template
# Copy this file to .env and fill in your real configuration
# ===================================

# Watchlist (comma-separated)
# US: AAPL, MSFT, NVDA (indices such as SPX also work)
# Canada: RY.TO, SHOP.TO, ABX.V
# Hong Kong and mainland China codes are not currently supported
STOCK_LIST=AAPL,MSFT,NVDA,RY.TO

# Futu OpenD (portfolio import)
# --portfolio futu only reads LONG US equity positions from ACTIVE REAL NORMAL / MASTER accounts; positions in other Futu markets are skipped.
# futu-api 10.8 supports IPv4 only. When Docker connects to OpenD on the host, do not use the container's own 127.0.0.1; see docs/full-guide.md.
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# FUTU_SECURITY_FIRM=NONE          # Optional; OpenD detects it automatically by default, or name the broker explicitly
# FUTU_ACC_ID=                    # Optional; a positive integer. When set, only that real account is read

# Anspire Open API keys (optional; a China-based gateway, not needed for US/Canada use)
# Multiple keys supported, comma-separated
# Get one at: https://open.anspire.cn/?share_code=QFBC0FYC
# When no higher-priority OpenAI-compatible source is configured, this key can be reused for the Anspire LLM gateway and news search where eligible.
# The gateway and model below are this project's example configuration; check the Anspire console and official docs for current availability:
# Example gateway: https://open-gateway.anspire.cn/v6
# Example model: Doubao-Seed-2.0-lite (override with ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro)
# If the gateway differs by region or version, override with ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true
# Data source configuration
# US and Canada need no key for basic use (Yahoo Finance). Recommended keyed backups: FINNHUB_API_KEY (US) and Longbridge (US), both below.
# Screening (US equities, disabled by default; modelled on the AlphaSift implementation; normally managed by the screening toggle under Basic Settings in the web UI)
SCREENING_ENABLED=false
# Whole-market snapshot source priority; the only supported source is yfinance (the default).
# SNAPSHOT_SOURCE_PRIORITY=yfinance
# US screening universe: comma-separated tickers. When unset, the S&P 500 list is tried first, then a built-in large-cap list.
# SCREENING_US_TICKERS=AAPL,MSFT,NVDA
# Timeout guardrails for third-party data-source calls during screening.
# - SCREENING_SOURCE_CALL_TIMEOUT_SEC is the global fallback; set it to 0/off/disabled to turn off the caller-side timeout.
# - The SNAPSHOT/Daily specific values take precedence over the global one; defaults are 60s / 20s respectively.
# SCREENING_SOURCE_CALL_TIMEOUT_SEC=
# SCREENING_SNAPSHOT_CALL_TIMEOUT_SEC=60
# SCREENING_DAILY_CALL_TIMEOUT_SEC=20
# Screening supports last-good snapshots and daily-bar history; the default directory is data/screening.
# Override the paths below to customize; leaving them empty does not rewrite existing DSA configuration.
# SCREENING_DATA_DIR=data/screening
# SCREENING_FALLBACK_SNAPSHOT_PATH=data/screening/snapshot.last_good.json
# A repeat screening run within 5 minutes reuses the last successful whole-market snapshot by default; set to 0 to disable.
# SCREENING_SNAPSHOT_CACHE_TTL_SEC=300
# SCREENING_DAILY_HISTORY_CACHE_DIR=data/screening/daily_history
# Timeout in seconds for a single LLM request. Screening reuses this setting and degrades to non-LLM ranking on timeout.
# LLM_TIMEOUT_SEC=60
# Output limit for the screening LLM re-ranking request; default 2048.
# LLM_MAX_TOKENS=2048

# Finnhub (recommended keyed backup for US market data, free tier 60 calls/min)
# Get one at: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage (optional, US market data source, free tier 25 calls/day)
# Get one at: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI (optional; fallback for US volume ratio, turnover rate, PE and similar fields)
# Get one at https://open.longbridge.com/
# OAuth 2.0 (recommended): first run scripts/generate_longbridge_oauth_token.py to generate the local SDK token cache
# client_id is taken from LONGBRIDGE_OAUTH_CLIENT_ID first; when empty and there is no legacy access token, LONGBRIDGE_APP_KEY is used for compatibility
# For GitHub Actions / Docker, base64-encode the token cache file and put it in LONGBRIDGE_OAUTH_TOKEN_CACHE_B64
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API key (for older accounts; this access token is not an OAuth access token)
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# In-process cache lifetime for static_info in seconds, default 86400; 0 = fetch on every request
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# Cooldown in seconds after a connection-closed error, default 15; Longbridge is skipped temporarily during the cooldown to avoid frequent per-request reconnects
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# The Longbridge SDK language follows REPORT_LANGUAGE (zh/en); SDK logs are written to LOG_DIR/longbridge_sdk.log
# Endpoints (independent of REPORT_LANGUAGE; leave empty to use the defaults below):
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# Override the endpoint. Internally the SDK selects it via LONGPORT_REGION (without BRIDGE),
# and the code syncs LONGBRIDGE_REGION to LONGPORT_REGION automatically.
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# For the rest, see: https://open.longbridge.com/zh-CN/docs/getting-started#环境变量
# Overnight quotes, true/false, default false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# Candlestick push mode, realtime or confirmed, default realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# Whether to print quote packets on connect (consistent with README / full-guide: when unset the application defaults to off, equivalent to false)
# Set to 1 / true / yes to enable verbose SDK quote-packet logging (useful when debugging the Longbridge connection)
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# Remote updates for the stock autocomplete index (off by default). The built-in source is the upstream project's GitHub main,
# whose index includes markets this fork does not support (CN, KR, JP), so a refresh is rejected as invalid and the bundled
# index (US, CA) is used anyway. Enable it only after the built-in source points at an index with the supported markets.
STOCK_INDEX_REMOTE_UPDATE_ENABLED=false

# ===================================
# AI model configuration
# ===================================
# Full documentation: docs/LLM_CONFIG_GUIDE.md
#
# [Quick start] Fill in a single API key and it runs; the system detects the model automatically.
#   Gemini (free quota) -> set GEMINI_API_KEY
#   Anthropic Claude -> set ANTHROPIC_API_KEY
#   OpenAI -> set OPENAI_API_KEY
#   OpenRouter (one key for many models) -> see the OpenRouter channel template below
#   Ollama (local, no key) -> set OLLAMA_API_BASE
#   Optional China-based providers: DeepSeek (DEEPSEEK_API_KEY), AIHubmix (AIHUBMIX_KEY), Anspire (ANSPIRE_API_KEYS)
#
# [Advanced] For multi-model or multi-platform fallback, configure the multi-channel section below, or manage it visually in the web settings page.
# Each channel can select chat_completions (default) or responses explicitly through LLM_<CHANNEL>_API_SURFACE.
# responses requires PROTOCOL=openai, and MODELS must not use LiteLLM direct-provider prefixes such as anthropic/, gemini/, or xai/;
# a gateway's own slash-containing model ID (such as deepseek-ai/DeepSeek-V3) is routed as an OpenAI-compatible model ID.
# The same normalized model alias must not appear in both a chat_completions and a responses channel; use different aliases when you need both surfaces.
# All models within one channel must use the same API surface; do not rely on the endpoint switching automatically after a failure.
# If Anspire `/models` and the connection test confirm the target model uses Responses (for example the currently observed GPT-5.6 sol/terra/luna), use channel mode and set LLM_ANSPIRE_API_SURFACE=responses.
# ===================================

# Generation backend: litellm by default. codex_cli / claude_code_cli / opencode_cli are explicitly opt-in local CLI backends (experimental/limited).
# The OpenCode CLI uses your local OpenCode default model; OPENCODE_CLI_MODEL is only an optional --model override.
# A local CLI backend is not an offline model: the service behind the CLI may process stock codes, news, portfolio context, analysis prompts, and report drafts.
# Docker / CI / remote servers do not inherit a desktop CLI login; DSA does not read Claude/OpenCode credential files.
# DSA uses a minimal env allowlist plus a provider credential denylist to reduce the risk of leaking API keys and webhook tokens.
# The quick check in the web settings page only reads configuration and executable visibility; only the JSON test issues a real generation-backend smoke request.
GENERATION_BACKEND=litellm
# OPENCODE_CLI_MODEL=provider/model
# Backend-level fallback. An empty value in a local .env disables backend-level fallback, and litellm -> litellm resolves to a no-op.
# When the variable is unset, the default GitHub Actions workflow uses litellm explicitly; to disable fallback in Actions, set it to the primary backend for a self no-op.
GENERATION_FALLBACK_BACKEND=litellm
# Execution limits for local CLI backends: timeout up to 3600, output up to 33554432 bytes, concurrency up to 16 / 4 respectively.
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# How ask-stock Chat runs. auto (recommended) and litellm keep the current default model path; codex_app_server calls Codex on the machine running the DSA backend (experimental, single-agent Chat on macOS/Linux/full WSL backends only; native Windows is not supported yet). The settings page only checks whether an attempt is possible; login, model, and tool execution are verified on the first real question.
AGENT_BACKEND=auto
# Legacy Agent model-routing compatibility option; ordinary users should use AGENT_BACKEND in the web settings page.
AGENT_GENERATION_BACKEND=auto

# --- API key (one is enough) ---

# Gemini（https://aistudio.google.com）
GEMINI_API_KEY=
# Load-balance across multiple keys: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek（https://platform.deepseek.com）
# Compatibility default: with only DEEPSEEK_API_KEY set, deepseek-chat is still used, and the log suggests migrating to deepseek-v4-flash
# DEEPSEEK_API_KEY=

# AIHubmix aggregator (https://inferera.com/?aff=CfMq)
# One key for GPT/Claude/Gemini/GLM/Qwen and other models, with no VPN required
# AIHUBMIX_KEY=

# Anthropic Claude（https://console.anthropic.com）
# ANTHROPIC_API_KEY=

# OpenAI / compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # Third-party API address (relay/proxy); leave empty for the official one

# Ollama local models (no API key needed, recommended)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# Or use channel mode:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b
#
# LLM channel base URLs on private networks (192.168.x.x, 10.x.x.x, 172.16-31.x.x, fc00::/7,
# host.docker.internal, *.local, ...) are rejected by default to stop the settings page from being
# used as an SSRF proxy. Loopback (localhost / 127.0.0.1) is always allowed. Set to true when your
# LLM endpoint lives on another machine in your LAN or on the Docker host.
# LLM_ALLOW_PRIVATE_BASE_URLS=false

# Sampling temperature (0.0-2.0, default 0.7; 0 is most deterministic, 2 is most random)
# Sources for strict-temperature compatibility:
# - Moonshot API / model docs: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Moonshot official model card (evaluation default temperature = 1.0): https://huggingface.co/moonshotai/Kimi-K2.6
# - OpenAI Chat Completions specification: https://platform.openai.com/docs/api-reference/chat/create
# - LiteLLM OpenAI-compatible specification: https://docs.litellm.ai/docs/providers/openai_compatible
# Current repository runtime dependency constraint: litellm>=1.80.10,!=1.82.7,!=1.82.8,<1.99.0 (explicitly excluding the broken PyPI releases and narrowing the upper bound to verified versions; see requirements.txt).
# As a result kimi-k2.6 automatically switches to 1.0/0.6, and default-temperature models such as GPT-5 / o-series omit temperature entirely so the API does not reject the request.
# If a compatible platform returns an explicit unsupported-parameter error, the runtime fixes the parameter within the current request and retries once; the successful strategy is cached in-process only.
# top_p, presence_penalty, frequency_penalty, and seed trigger the same request-level correction and retry when they return an unsupported-parameter error (LLM_TEMPERATURE is not rewritten).
# Other models and fallbacks still use the LLM_TEMPERATURE you configured.
# The web settings page and desktop import never silently clear or rewrite LLM_TEMPERATURE; model parameters are adapted only just before a request is actually sent.
# If the primary model switches back to an ordinary model, your configured temperature is restored automatically; the minimal rollback is to revert this LLM parameter-adaptation change.
# LLM_TEMPERATURE=0.7

# Output-token budget of the stock analysis call. 0 (default) is automatic: 8192, raised to at most 16384 when
# LiteLLM knows the output limit of every configured model (primary and fallbacks) and all of them allow it.
# A positive value is used as is, capped to the known limit of the configured models. Models that reason before
# answering spend part of the budget on hidden tokens, so a budget that is too small cuts the report off; a cut-off
# reply is retried once with a larger budget when the models allow it.
# ANALYSIS_MAX_OUTPUT_TOKENS=0

# LLM usage telemetry message HMAC configuration (optional)
# When left empty, the system generates .llm_usage_hmac_secret in the data directory, which is stable for comparison within a local deployment.
# Only set the same random secret explicitly when you need to compare usage message HMACs across deployments; update the version tag when rotating.
# When setting it explicitly, use a high-entropy random value (for example openssl rand -hex 32), and never commit a real secret to version control.
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Provider prompt cache configuration (optional)
# TELEMETRY only controls provider cache usage / diagnostics recording; it does not control the provider's implicit cache.
# HINTS controls whether verified provider-specific hints such as prompt_cache_key, cache_control, and user_id are sent proactively; off by default.
# DIAGNOSTICS_LEVEL accepts off/basic/debug; even debug emits only redacted diagnostics and never logs the raw prompt or request body.
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

# --- Multi-channel configuration (optional; can also be configured in the web settings page) ---
# Each channel configures base_url / api_key / models independently, with multi-key rotation and automatic fallback.
#
# Example: DeepSeek + Gemini dual channels
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview
#
# Example: custom API endpoint (third-party proxy / aggregator platform / relay)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-5.5,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# Example: Ollama local models (no API key needed)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# Example: Hermes local HTTP generation (Phase 3, ordinary analysis/JSON only; Agent tools, streaming, and vision are not supported)
# LLM_CHANNELS=hermes
# LLM_HERMES_PROTOCOL=openai
# LLM_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# LLM_HERMES_API_KEY=sk-local-hermes
# LLM_HERMES_MODELS=hermes-agent
# LITELLM_MODEL=openai/hermes-agent
#
# Common provider templates (copy one into .env; see docs/llm-providers.md for full documentation)
#
# Anspire Open (shared search and LLM key, OpenAI compatible)
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6 (example)
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro (example models)
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite (example)
#
# AIHubmix aggregator platform (OpenAI compatible)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-5.5,claude-sonnet-4-6,gemini-3.1-pro-preview
# LITELLM_MODEL=openai/gpt-5.5
#
# OpenAI official
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# LITELLM_MODEL=openai/gpt-5.5
#
# DeepSeek official
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini official (native protocol, leave Base URL empty)
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
#
# Anthropic Claude official (native protocol, leave Base URL empty)
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot（OpenAI Compatible）
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# Qwen DashScope (OpenAI compatible)
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# Zhipu GLM (OpenAI compatible)
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax（OpenAI Compatible）
# Source: official OpenAI-API compatibility docs https://platform.minimax.io/docs/api-reference/text-chat
# LiteLLM routes through openai/<model> to a Chat Completions-compatible base URL.
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# Xiaomi MiMo (OpenAI compatible)
# Take the base URL and model names from the official MiMo docs or console.
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# Note: the repository's default daily_analysis workflow does not pass LLM_MIMO_* through explicitly, so this example targets a local .env, Docker, or self-hosted scripts; to use it in Actions, add the matching workflow mapping.
#
# Volcano Ark / Doubao (OpenAI compatible; adjust the endpoint to the region you enabled)
# Source: Volcano Ark online inference / Responses API docs https://www.volcengine.com/docs/82379/2121998
# LiteLLM routes through openai/<model> to a Chat Completions-compatible base URL.
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# SiliconFlow (OpenAI compatible)
# Source: official model list https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter（OpenAI Compatible）
# Source: official Models API https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest

# Advanced: model-routing YAML configuration (optional; see docs/examples/litellm_config.example.yaml)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# Search engine configuration (used to fetch stock news)
# ===================================
# Search providers run in this order: Tavily, Brave, SerpAPI, SearXNG, then the optional China-based ones.
# Tavily API keys (multiple allowed, comma-separated)
TAVILY_API_KEYS=
# Brave Search API keys (multiple allowed, comma-separated)
# Get one at: https://brave.com/search/api/
BRAVE_API_KEYS=
# SerpAPI keys (multiple allowed, comma-separated)
SERPAPI_API_KEYS=
# Optional, China-based (Chinese-language coverage; not needed for US/Canada use):
# Bocha API keys (optimized for Chinese search, supports AI summaries, multiple allowed, comma-separated)
# Get one at: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API key (Coding Plan web search, multiple allowed, comma-separated)
# Get one at: https://platform.minimax.io/
# MINIMAX_API_KEYS=your_minimax_key_here
# SearXNG instance URLs (comma-separated; a private deployment has no quota, and settings.yml must enable format: json)
# The GitHub Actions daily analysis workflow prefers same-named Variables and falls back to Secrets; a public address can be configured as a Variable.
# When empty and the toggle below is true, public instances are pulled automatically from searx.space. Public instances commonly rate-limit (429),
# go offline (503), or have JSON output disabled, so retrying them one by one adds 30-60 seconds per analysis and still ends up with no news,
# which is why it is off by default. Prefer configuring your own instance (SEARXNG_BASE_URLS), or use any of the keyed search channels above.
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
# Timeout for a single search against a self-hosted SearXNG (seconds, default 10, minimum 1); public instances are unaffected by this setting
SEARXNG_TIMEOUT_SECONDS=10

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# Reddit / X (Twitter) / Polymarket sentiment data from api.adanos.org
# Only activates for US stock tickers (AAPL, TSLA, etc.)
# Free tier: 250 requests/month | Register: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# News recency and analysis filtering configuration
# ===================================
# News strategy window tiers: ultra_short (1 day) / short (3 days) / medium (7 days) / long (30 days)
# Effective window = min(strategy window, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# Maximum news age (days); restricts search results to recent items so stale information is not used
# NEWS_MAX_AGE_DAYS=3
# Retention in days for the local news/intelligence pool; only intelligence_items is cleaned, historical reports are untouched
# NEWS_INTEL_RETENTION_DAYS=30
# Fetch timeout for a single RSS/Atom news source (seconds)
# NEWS_INTEL_FETCH_TIMEOUT_SEC=8
# Maximum items collected per news source per run
# NEWS_INTEL_MAX_ITEMS_PER_SOURCE=50
# When enabled, the built-in news sources are initialized and the enabled ones fetched before single-stock analysis, Agent analysis, and market review read the local pool;
# off by default, to avoid unconfirmed external requests and changes to the analysis input
# Note: the repository's default daily_analysis workflow does not pass this variable through explicitly; add the matching workflow mapping to use it in Actions
# NEWS_INTEL_AUTO_FETCH_ENABLED=false
# Bias-rate threshold (%); deviating from MA5 by more than this warns against chasing. Strong trending stocks automatically get 1.5x headroom
# BIAS_THRESHOLD=5.0

# ===================================
# Agent strategy chat configuration (web chat page)
# ===================================
# Enable Agent strategy chat (default false; internally named skill throughout)
# AGENT_MODE=true
# Primary model for default-model ask-stock (optional): inherits the primary model when empty; a value with no provider prefix resolves as openai/<model>; Codex ignores this
# AGENT_LITELLM_MODEL=
# Agent resource limit: for the default model this caps reasoning steps (at the default of 10 each sub-agent runs on its own preset); for Codex it caps tool calls per question
# AGENT_MAX_STEPS=10
# Strategies enabled by default (comma-separated); the built-in defaults below are used when unset
#
# Built-in strategy skills (combine freely):
#   bull_trend          - Bull trend (MA5>MA10>MA20 alignment + low bias rate)
#   ma_golden_cross     - Moving-average golden cross (MA5 crossing above MA10/MA20)
#   volume_breakout     - Volume breakout (price breaks a recent high + volume expansion)
#   event_driven        - Event driven (earnings, policy, orders, M&A and other catalysts)
#   growth_quality      - Growth quality (revenue and profit, ROE, cash flow, growth durability)
#   expectation_repricing - Expectation repricing (earnings/policy/valuation expectation gaps closing or failing)
#   shrink_pullback     - Shrinking pullback (pullback to a moving average + contracting volume, a low-entry point)
#   bottom_volume       - Bottom volume expansion (floor volume marks the floor price, a bottom-reversal signal)
#   sector_leadership   - Sector leadership (sector and theme leaders by relative strength)
#   rising_three_methods - Rising three methods (a bullish continuation candlestick pattern)
#   box_oscillation     - Box oscillation (sell high and buy low within a range)
#   structure_divergence - Structure and divergence (higher highs/lows, ranges, breakouts and divergences)
#   wave_theory         - Wave theory (Elliott wave counting)
#   sentiment_extremes  - Sentiment extremes (capitulation lows and euphoric highs)
#
# When left empty, the system uses the primary default strategy skill declared in metadata (the built-in default is bull_trend)
# AGENT_SKILLS=
#
# You can also specify a set of strategies manually:
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# Enable every built-in strategy (both forms are equivalent):
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,event_driven,growth_quality,expectation_repricing,shrink_pullback,bottom_volume,sector_leadership,rising_three_methods,box_oscillation,structure_divergence,wave_theory,sentiment_extremes
#
AGENT_SKILLS=
# Custom strategy directory (optional; place custom YAML strategy files here. The variable name follows the internal skill naming)
# AGENT_SKILL_DIR=./strategies

# Agent architecture mode (default single; multi enables multi-agent orchestration)
# AGENT_ARCH=single

# Multi-agent orchestration mode (only effective when AGENT_ARCH=multi)
# quick: technical analysis -> decision (fastest, about 2 LLM calls)
# standard: technical -> intel -> decision (default)
# full: technical -> intel -> risk -> decision
# specialist: technical -> intel -> risk -> strategy-specialist evaluation -> decision
# AGENT_ORCHESTRATOR_MODE=standard

# Agent execution timeout budget (seconds; on the default LiteLLM path 0 disables it; Codex requires a value above 0 so every question terminates; default 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# Independent timeout cap for a sub-agent (seconds, 0 = off; a positive value such as 180 gives that agent its own hard cap)
# Resolution rules:
#   - When the pipeline budget is off (AGENT_ORCHESTRATOR_TIMEOUT_S=0): the sub-agent cap applies on its own as that agent's absolute timeout
#   - When the pipeline budget is on: the effective cap is min(remaining pipeline budget, sub-agent cap), whichever is smaller
#   - When unset (default 0): there is no independent cap, only the remaining pipeline budget applies
# AGENT_TECHNICAL_AGENT_TIMEOUT_S=0
# AGENT_INTEL_AGENT_TIMEOUT_S=0
# AGENT_RISK_AGENT_TIMEOUT_S=0
# AGENT_DECISION_AGENT_TIMEOUT_S=0
# AGENT_PORTFOLIO_AGENT_TIMEOUT_S=0
# AGENT_SKILL_AGENT_TIMEOUT_S=0

# Per-category default timeout for Agent tools (seconds, 0 = off; falls back to the global tool_call_timeout_seconds budget when unset)
# The effective timeout resolves first-wins: explicit per-run tool_call_timeout_seconds > an explicit per-tool timeout_seconds > the category default > unlimited;
# the remaining wall-clock budget acts only as an outer cap that cannot be exceeded; inf/nan/negative are treated as unlimited.
# Market-category tools (network data calls such as get_market_indices / get_sector_rankings) reuse AGENT_DATA_TOOL_TIMEOUT_S and have no separate switch.
# AGENT_DATA_TOOL_TIMEOUT_S=0
# AGENT_SEARCH_TOOL_TIMEOUT_S=0
# AGENT_ANALYSIS_TOOL_TIMEOUT_S=0
# AGENT_ACTION_TOOL_TIMEOUT_S=0

# Strategy-specialist concurrency (specialist mode only; range 1-4, default 3)
# AGENT_SKILL_CONCURRENCY=3

# Whether the risk agent may veto a buy signal (on by default)
# AGENT_RISK_OVERRIDE=true

# Memory and calibration system (tracks historical accuracy and adjusts confidence automatically)
# AGENT_MEMORY_ENABLED=false

# Conservatively weight strategy opinions using real skill outcomes once samples are sufficient
# AGENT_SKILL_AUTOWEIGHT=true

# Strategy routing mode (auto = choose automatically from market state / manual = use the AGENT_SKILLS list)
# AGENT_SKILL_ROUTING=auto

# Visible chat context compression for ask-stock (off by default). When enabled, only the user-visible user/assistant history is compressed; tool/thinking pass-through within the same turn is unaffected.
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# Compression strategy: cost = fewer tokens / balanced = a middle ground / long_context_raw_first = keep more of the original text
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# History token threshold that triggers compression; leave empty to follow the current profile preset
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# During compression the most recent N user turns and the replies after them stay verbatim; leave empty to follow the current profile preset
# AGENT_CONTEXT_PROTECTED_TURNS=

# Event alert monitoring (background polling in schedule mode; triggers reuse the configured notification channels)
# Compatibility note: this section only adds alert-rule configuration. It does not change model names, providers, base URLs, LiteLLM, or LLM configuration semantics; to roll back, simply disable or remove the event-monitoring configuration.
# The legacy JSON supports only three basic single-symbol rule types; configure technical-indicator, watchlist, portfolio/account, and market-light rules through the web/API alert center.
# Rules supported by the legacy JSON:
#   price_cross          - Price crosses a threshold; direction: above / below; field: price
#   price_change_percent - Percentage-change threshold; direction: up / down; field: change_pct (unit: %)
#   volume_spike         - Volume expansion; field: multiplier (relative to the 20-day average volume)
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"600519","alert_type":"price_cross","direction":"above","price":1800},{"stock_code":"300750","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"000858","alert_type":"volume_spike","multiplier":2.5}]
# ===================================
# Notification channel configuration (configure several at once; all of them receive pushes)
# ===================================
#
# [Option 3] Telegram bot (both settings are required)
# 1. In Telegram, message @BotFather -> /newbot -> get the bot token
# 2. Get the chat ID: message @userinfobot, or visit https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# [Option 4] Email delivery (only 2 settings; SMTP is detected automatically)
# Supports QQ Mail, 163 Mail, Gmail, and other providers offering SMTP app passwords or basic authentication
# Outlook / Exchange tenants that mandate OAuth2 are not supported in the current version
# 1. Get an app password (QQ Mail as an example): Settings -> Account -> POP3/SMTP service -> enable -> get the app password
# 2. Fill in the two settings below:
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # Optional; leave empty to send to yourself
#
# [Option 4 extension] Send stock groups to different mailboxes (Issue #268, optional)
# STOCK_LIST determines what is actually analyzed; STOCK_GROUP_N only determines who receives the email, so keep it a subset of STOCK_LIST
# Other channels such as Telegram and webhooks still push the full STOCK_LIST and are not split by group
# The repository's default GitHub Actions daily_analysis workflow does not auto-inject arbitrarily numbered STOCK_GROUP_N / EMAIL_GROUP_N
# So this capability suits a local .env, Docker, or any runtime that injects those variables explicitly
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# [Option 5] Custom webhook (multiple allowed, comma-separated)
# Works with any webhook that accepts POST JSON: Discord, Slack, Bark, self-hosted services, and so on
# The system detects common services automatically and uses the matching format
#
# CUSTOM_WEBHOOK_URLS=https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # Optional, for webhooks requiring authentication (header Authorization: Bearer <token>)
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # Optional global JSON body template; overrides the automatic Bark/Slack/Discord payloads. $content_json/$title_json are recommended
# When hand-writing .env for Docker Compose, use $$content_json/$$title_json. The web settings page escapes this automatically and the runtime still resolves it back to a single $
# WEBHOOK_VERIFY_SSL=true   # Verification is on by default and applies to webhook-style HTTPS notification requests that read this setting. Set to false to allow self-signed certificates. Warning: disabling it exposes you to MITM attacks, so use it only on a trusted internal network
#
# [Option 6] Pushover configuration
# Register a Pushover account and create an application token at https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# [Option 6 extension] ntfy configuration
# NTFY_URL must include the topic path, for example https://ntfy.sh/my-topic or https://self-hosted:port/my-topic
# The system parses the topic and sends Markdown text through the ntfy JSON publish API.
# NTFY_URL=
# NTFY_TOKEN=  # Optional, for topics requiring a bearer token or for a self-hosted ntfy server
#
# [Option 6 extension] Gotify configuration
# GOTIFY_URL is the Gotify server base URL without /message; the system appends /message and sends the token in the X-Gotify-Key header.
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# [Option 8] Discord configuration
# Two approaches are supported: webhook (recommended, simple to configure) and the bot API (more privileges)
# 
# Approach 1: Discord webhook (recommended, no bot account required)
# In Discord channel settings -> Integrations -> Webhooks -> New Webhook -> copy the URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# Approach 2: Discord bot API (requires a bot account and a channel ID)
# 1. Create a bot: https://discord.com/developers/applications -> New Application -> Bot -> Add Bot
# 2. Get the bot token: the Bot page -> Reset Token
# 3. Get the channel ID: enable developer mode in Discord -> right-click the channel -> Copy ID
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # Legacy variable name kept for compatibility; prefer DISCORD_MAIN_CHANNEL_ID
# DISCORD_MAX_WORDS=2000 # Discord caps a single content field at 2000; the runtime truncates to 2000 and splits long reports across messages
# Inbound slash commands (POST /api/v1/bot/discord/interactions): set the public key used to verify every request
# Where to find it: Discord Developer Portal -> General Information -> Public Key; setup: docs/bot/discord-bot-config.md
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# Only for scripts/register_discord_commands.py (General Information -> Application ID)
# DISCORD_APPLICATION_ID=
# 
# [Option 9] Slack configuration
# Two approaches are supported: the bot API (recommended) and an incoming webhook
# When both are configured the bot API wins, which keeps text and images in the same channel.
#
# Approach 1: Slack bot API (recommended, supports image upload)
# 1. Create a Slack app: https://api.slack.com/apps -> Create New App
# 2. Add the bot token scopes: chat:write, files:write
# 3. Install it to the workspace and get the bot token (xoxb-...)
# 4. Get the channel ID: channel details -> copy the channel ID at the bottom
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# Approach 2: Slack incoming webhook (simple to configure, no image upload)
# Create an incoming webhook in the Slack app management page -> copy the URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# [Option 11] AstrBot configuration
# ASTRBOT_URL=
# ASTRBOT_TOKEN=  # Optional, for AstrBot webhooks requiring a bearer token
#
# [Advanced] Message length limits (bytes)
# Anything over the limit is split across messages automatically; you rarely need to change this
#
# [Markdown to image] (Issue #455)
# For channels that do not support Markdown, send the report as an image to improve readability
# Single-stock push plus images: both MARKDOWN_TO_IMAGE_CHANNELS and an installed conversion tool are required
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,custom,email,slack   # comma-separated
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # Anything longer is not converted, which avoids oversized images
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage (default) | markdown-to-file | playwright (requires the web dependencies and npx playwright install chromium)
# Share images show no social account by default; set any of the settings below to add a Xiaohongshu card (URL, handle and/or QR code) to the footer
# SHARE_IMAGE_XIAOHONGSHU_URL=
# SHARE_IMAGE_XIAOHONGSHU_HANDLE=@my-account
# SHARE_IMAGE_XIAOHONGSHU_QR_PATH=assets/my-xiaohongshu-qr.png  # Absolute, or relative to the project root
# Conversion tools: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf), or markdown-to-file
#
# [Notification routing policy] (Issue #1200 P3)
# Empty by default: that notification type goes to every configured channel. Once set, it goes only to the configured channels listed.
# Allowed values: telegram,email,pushover,ntfy,gotify,custom,discord,slack,astrbot
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# [Notification noise reduction] (Issue #1200 P4)
# All off by default; affects static notification channels only, not bot-triggered conversation receipts.
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # The same stable dedup key is sent only once within the TTL; 0 disables it
# NOTIFICATION_COOLDOWN_SECONDS=0       # Rate-limits the same cooldown key within the window; 0 disables it
# NOTIFICATION_QUIET_HOURS=             # Quiet hours, format HH:MM-HH:MM, may span midnight
# NOTIFICATION_TIMEZONE=                # Timezone for quiet hours, such as America/New_York; leave empty to follow TZ or the system local timezone
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical; leave empty to keep current behaviour
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # Reserved setting; no daily digest is sent at present
# ===================================
# Single-stock push configuration (optional)
# ===================================
# Single-stock push mode: push as soon as each stock finishes analysis instead of after the summary
# SINGLE_STOCK_NOTIFY=false
#
# Report type: simple (condensed), full (complete), brief (a 3-5 sentence summary)
# If pushed content is incomplete in a Docker environment, set this to full
# REPORT_TYPE=simple
# Report output language: en (English) is the only value; reports are English-only
# REPORT_LANGUAGE=en
# Summary only: when true, only the aggregate is pushed, with no per-stock detail
# REPORT_SUMMARY_ONLY=false
# Show the LLM model name used for this analysis at the bottom of the notification report; set to false to hide it
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / completeness validation / historical comparison)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# Combine single-stock analysis and market review into one push (default false), which reduces email volume and spam risk
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# Analysis interval configuration (optional)
# ===================================
# Delay between single-stock analysis and market analysis (seconds)
# Used to avoid tripping rate limits on AI APIs such as Gemini
# ANALYSIS_DELAY=0

# Database path
DATABASE_PATH=./data/stock_analysis.db
# SQLite write tuning: WAL is enabled by default for file-backed databases, which reduces lock contention during bulk writes and concurrent write-back
SQLITE_WAL_ENABLED=true
# SQLite lock wait timeout (milliseconds)
SQLITE_BUSY_TIMEOUT_MS=5000
# Maximum retries when SQLite reports database is locked / database table is locked
SQLITE_WRITE_RETRY_MAX=3
# Base backoff for SQLite write retries (seconds, growing exponentially)
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# Analysis history snapshot: when false, the full context_snapshot is not persisted
# This covers the enhanced_context, market_phase_summary, AnalysisContextPack overview, diagnostics, and raw snapshot fields
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# Backtesting configuration (optional)
# ===================================
# Whether backtesting is enabled (true/false)
BACKTEST_ENABLED=true
# Backtest evaluation window (in trading days)
BACKTEST_EVAL_WINDOW_DAYS=10
# Only backtest analysis records older than N days (avoids incomplete same-day or very recent data)
BACKTEST_MIN_AGE_DAYS=14
# Backtest engine version (used to distinguish results when the backtest logic changes)
BACKTEST_ENGINE_VERSION=v1
# Neutral band threshold (%); for example 2 means -2% to +2% counts as range-bound
BACKTEST_NEUTRAL_BAND_PCT=2.0

# === Scheduled task configuration ===
# Whether the scheduled job is enabled (true/false)
SCHEDULE_ENABLED=false
# Daily execution time (HH:MM, 24-hour clock)
SCHEDULE_TIME=18:00
# List of multiple execution times (comma-separated; SCHEDULE_TIME is used when empty)
SCHEDULE_TIMES=
# Hard timeout for a single analysis in the Web/API runtime scheduler (seconds, minimum 60)
DSA_RUNTIME_SCHEDULER_TIMEOUT_SECONDS=2700
# Whether to push a partial-completion notification for already-persisted stocks after a hard timeout (true/false; default true, enabled when unset, whereas a timeout previously pushed nothing)
DSA_TIMEOUT_PARTIAL_NOTIFY=true
# Whether scheduled mode runs an analysis immediately at startup (true/false)
# When not set explicitly, scheduled mode inherits the runtime override semantics of RUN_IMMEDIATELY for backward compatibility
SCHEDULE_RUN_IMMEDIATELY=true
# Whether non-scheduled mode runs an analysis immediately at startup (true/false)
RUN_IMMEDIATELY=true
# Whether market review is enabled (true/false)
MARKET_REVIEW_ENABLED=true
# Whether to inject the market-environment summary into the single-stock analysis prompt and enable the conservative guardrail (true/false, on by default)
DAILY_MARKET_CONTEXT_ENABLED=true
# Market review regions: ca (Canada), us (US), both (all markets);
# a comma-separated subset is supported (such as ca,us); an invalid or empty value falls back to us. ca/hk/us suit users who follow only that one region
# MARKET_REVIEW_REGION=us
# Index up/down colours in market review: green_up = green for up and red for down (default), red_up = red for up and green for down
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# Proxy configuration (optional)
# ===================================
# Whether the proxy is enabled (true/false, default false)
# Applies to local development only; the GitHub Actions environment skips it automatically
USE_PROXY=false
# Proxy server address (default 127.0.0.1)
PROXY_HOST=127.0.0.1
# Proxy server port (default 10809)
PROXY_PORT=10809

# System configuration
# Log directory
LOG_DIR=./logs
# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Timezone whose midnight and month start cut the token-usage periods (default America/Toronto)
# USAGE_TIMEZONE=America/Toronto
# LiteLLM internal log level (DEBUG/INFO/WARNING/ERROR/CRITICAL; default WARNING; set it to DEBUG temporarily when investigating internal streaming or routing details)
# LITELLM_LOG_LEVEL=WARNING
# Maximum concurrent threads (keeping concurrency low helps avoid being blocked)
MAX_WORKERS=3
# Whether debug logging is enabled
DEBUG=false

# ===================================
# WebUI configuration (optional)
# ===================================
# Whether the WebUI starts by default (true/false, default false)
WEBUI_ENABLED=false
# WebUI listen address (default 127.0.0.1; Docker and cloud servers must set 0.0.0.0 to be reachable externally, see docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# WebUI listen port (default 8000)
WEBUI_PORT=8000
# Docker Compose only: host interface the API port is published on (default 127.0.0.1, loopback only).
# Set 0.0.0.0 to reach the container from other machines, and enable ADMIN_AUTH_ENABLED=true first.
# API_BIND_HOST=127.0.0.1
# Whether to build the frontend automatically before starting the web service (npm install && npm run build, default true)
WEBUI_AUTO_BUILD=true
# Behind a single trusted reverse proxy (such as Nginx -> App), trust X-Forwarded-For for the real IP and take the rightmost value for login rate limiting. With multi-tier proxies or a CDN the rate-limit key may degrade to the edge proxy IP, so evaluate that separately. Keep it false when directly exposed to the internet, to prevent spoofing
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web login authentication (optional)
# ===================================
# Set to true to enable password protection. Set the initial password in the browser on first visit; it can be changed later under System Settings > Change Password
# If you forget the password, run this on the server: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session lifetime (hours)

# ===========================================
# Extract stock codes from an image (the Add from image action in the settings page)
# ===========================================
# A single request times out after 60 seconds; images are capped at 5MB
# At least one of GEMINI_API_KEY, ANTHROPIC_API_KEY, or OPENAI_API_KEY must be configured (a vision-capable model)

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priority: yfinance(4); Longbridge, Finnhub and Alpha Vantage are optional extra sources.
# To use Yahoo Finance first, set YFINANCE_PRIORITY=0

# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4

# ===========================================
# Real-time quotes
# ===========================================
# Whether real-time quotes are enabled (when off, analysis uses historical closing prices)
# ENABLE_REALTIME_QUOTE=true

# Intraday real-time technicals: when enabled, MAs and bullish alignment are computed from the live price (Issue #234); when disabled, yesterday's close is used
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# Whether fundamental aggregation is enabled (new P0 capability)
# ENABLE_FUNDAMENTAL_PIPELINE=true

# Performance and stability parameters for fundamental aggregation (in seconds)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: import / risk / FX degradation configuration
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

